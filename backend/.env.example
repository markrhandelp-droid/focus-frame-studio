# Copy this file to .env for local development. Never commit .env.
# On Render, add the same keys under Environment instead.

PORT=5000
NODE_ENV=development

# Front-end origins allowed by CORS (comma-separated).
# Add your Netlify URL in production, e.g. https://focus-frame.netlify.app
CLIENT_ORIGIN=http://localhost:5173

# Google accounts that become "admin" when they sign in (comma-separated).
ADMIN_EMAILS=markrhandel6@gmail.com

# Firebase: verifying ID tokens only needs the project ID.
FIREBASE_PROJECT_ID=focus-frame-studio
# Optional: service account JSON encoded as base64 (not needed for token checks).
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---- MySQL ----------------------------------------------------------------
# Local XAMPP (MariaDB) defaults:
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=qqyy7VXS9LrBKkv.root
DB_PASSWORD=pfWn5pOef4vUsUp8
DB_NAME=test
DB_SSL=true
DB_SSL_CA=

# Cloud MySQL example (Aiven):
# DB_HOST=mysql-xxxx-yourproject.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=your-aiven-password
# DB_NAME=defaultdb
# DB_SSL=true
# DB_SSL_CA=./certs/aiven-ca.pem      (path, or paste the PEM text itself)

# Alternatively, one connection string (overrides the DB_* host/user/etc.):
# DATABASE_URL=mysql://user:password@host:port/database

# Studio time zone used for "today" and overdue checks.
DB_TIMEZONE=+08:00
# Create missing tables and seed an empty database when the API starts.
DB_AUTO_MIGRATE=true
